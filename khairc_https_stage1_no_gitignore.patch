--- a/src/HttpsService.cpp
+++ b/src/HttpsService.cpp
@@ -0,0 +1,96 @@
+#include "HttpsService.h"
+#include "WifiService.h"
+#include <Arduino.h>
+
+// Stage 1: TLS read-only probe. Never exposes commands or OTA.
+// Missing credentials must NOT prevent the known-working Hub from booting.
+#if __has_include(<esp_https_server.h>) && __has_include("tls_credentials.h")
+#define KHAIRC_HTTPS_PROBE_ENABLED 1
+#include <esp_https_server.h>
+#include <esp_http_server.h>
+#include "tls_credentials.h"
+#else
+#define KHAIRC_HTTPS_PROBE_ENABLED 0
+#endif
+
+namespace {
+#if KHAIRC_HTTPS_PROBE_ENABLED
+    httpd_handle_t secureServer = nullptr;
+    constexpr unsigned long RETRY_MS = 30000;
+    bool attempted = false;
+    unsigned long lastAttempt = 0;
+
+    esp_err_t getHealth(httpd_req_t* request) {
+        char response[240];
+        const int count = snprintf(
+            response, sizeof(response),
+            "{\"status\":\"ok\",\"device\":\"KhaiRC-ESP32-Hub\","
+            "\"phase\":\"https_probe\",\"uptime_sec\":%lu,\"free_heap\":%u}",
+            static_cast<unsigned long>(millis() / 1000UL),
+            static_cast<unsigned int>(ESP.getFreeHeap()));
+        if (count < 0 || static_cast<size_t>(count) >= sizeof(response)) return ESP_FAIL;
+        httpd_resp_set_type(request, "application/json");
+        httpd_resp_set_hdr(request, "Cache-Control", "no-store");
+        return httpd_resp_send(request, response, count);
+    }
+
+    void startServer() {
+        auto config = HTTPD_SSL_CONFIG_DEFAULT();
+        config.port_secure = 443;
+        config.httpd.stack_size = 8192;
+        config.httpd.max_uri_handlers = 2;
+        config.httpd.max_open_sockets = 2;
+        config.httpd.lru_purge_enable = true;
+        config.servercert = reinterpret_cast<const uint8_t*>(HUB_TLS_CERT_PEM);
+        config.servercert_len = sizeof(HUB_TLS_CERT_PEM);
+        config.prvtkey_pem = reinterpret_cast<const uint8_t*>(HUB_TLS_KEY_PEM);
+        config.prvtkey_len = sizeof(HUB_TLS_KEY_PEM);
+
+        const esp_err_t started = httpd_ssl_start(&secureServer, &config);
+        if (started != ESP_OK) {
+            secureServer = nullptr;
+            Serial.printf("[HTTPS] TLS server start failed: %d\n", static_cast<int>(started));
+            return;
+        }
+
+        httpd_uri_t health{};
+        health.uri = "/api/v1/health";
+        health.method = HTTP_GET;
+        health.handler = getHealth;
+        if (httpd_register_uri_handler(secureServer, &health) != ESP_OK) {
+            httpd_ssl_stop(secureServer);
+            secureServer = nullptr;
+            Serial.println("[HTTPS] Unable to register health route");
+            return;
+        }
+        Serial.println("[HTTPS] Probe on 443 (only GET /api/v1/health)");
+    }
+#endif
+}
+
+namespace HttpsService {
+    void begin() {
+#if KHAIRC_HTTPS_PROBE_ENABLED
+        Serial.println("[HTTPS] Probe configured; starting when Wi-Fi is ready");
+#else
+        Serial.println("[HTTPS] Probe disabled: missing TLS credentials or HTTPS component");
+#endif
+    }
+
+    void loop() {
+#if KHAIRC_HTTPS_PROBE_ENABLED
+        const bool online = WifiService::connected();
+        if (!online && secureServer != nullptr) {
+            httpd_ssl_stop(secureServer);
+            secureServer = nullptr;
+            attempted = false;
+            Serial.println("[HTTPS] Stopped after Wi-Fi disconnect");
+        }
+        if (!online || secureServer != nullptr) return;
+        if (attempted && millis() - lastAttempt < RETRY_MS) return;
+        attempted = true;
+        lastAttempt = millis();
+        startServer();
+#endif
+    }
+}
--- a/tools/create_https_credentials.py
+++ b/tools/create_https_credentials.py
@@ -0,0 +1,36 @@
+"""Create untracked TLS header from user-generated PEM files. Never prints keys.
+
+Run after generating certificate and key with OpenSSL as in docs/HTTPS_STAGE1.md.
+"""
+from pathlib import Path
+import sys
+
+root = Path(__file__).resolve().parents[1]
+cert = root / 'include' / 'tls_certificate.pem'
+key = root / 'include' / 'tls_private_key.pem'
+header = root / 'include' / 'tls_credentials.h'
+
+if header.exists():
+    raise SystemExit('tls_credentials.h already exists; refusing to overwrite')
+
+def read_pem(path: Path, kind: str) -> str:
+    text = path.read_text(encoding='ascii')
+    if f'-----BEGIN {kind}-----' not in text or f'-----END {kind}-----' not in text:
+        raise SystemExit(f'Invalid {kind} PEM file: {path.name}')
+    if ')KHAIRC_TLS"' in text:
+        raise SystemExit('Unsupported PEM content delimiter')
+    return text
+
+try:
+    certificate = read_pem(cert, 'CERTIFICATE')
+    private = key.read_text(encoding='ascii')
+    if '-----BEGIN PRIVATE KEY-----' not in private and '-----BEGIN EC PRIVATE KEY-----' not in private:
+        raise SystemExit('Expected an unencrypted PEM private key')
+    header.write_text(
+        '#pragma once\n'
+        'static const char HUB_TLS_CERT_PEM[] = R"KHAIRC_TLS(' + certificate + ')KHAIRC_TLS";\n'
+        'static const char HUB_TLS_KEY_PEM[] = R"KHAIRC_TLS(' + private + ')KHAIRC_TLS";\n',
+        encoding='ascii')
+except FileNotFoundError:
+    raise SystemExit('Missing tls_certificate.pem or tls_private_key.pem in include/') from None
+print('Created ignored include/tls_credentials.h. Do not commit or share this file.')
--- a/docs/HTTPS_STAGE1.md
+++ b/docs/HTTPS_STAGE1.md
@@ -0,0 +1,39 @@
+# KhaiRC HTTPS - Stage 1 (LAN-only probe)
+
+This experimental build adds an ESP-IDF HTTPS server on ESP32 port **443** but only registers `GET /api/v1/health`. It does not expose IR commands, MiLife controls, OTA, or any secret. Existing Arduino `WebServer` port 80 and OTA port 8081 remain unchanged. Do **not** port-forward 443 yet. This is not a production release.
+
+Toolchain in `platformio.ini`: `espressif32 @ 8.0.0`, Arduino Core 3.3.12 / ESP-IDF 5.5.5. API based on `esp_https_server` official ESP-IDF 5.5.x documentation. Validate build because Arduino's prebuilt components may differ from a full ESP-IDF project.
+
+## Make a locally trusted test certificate
+
+From a terminal on your Windows development computer, run `openssl version` to confirm OpenSSL is available. If it is missing, stop rather than generating keys on a third-party website.
+
+From the project root in PowerShell:
+
+```powershell
+openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -sha256 -days 365 -keyout include/tls_private_key.pem -out include/tls_certificate.pem -subj "/CN=openwrt96.ddns.net" -addext "subjectAltName=DNS:openwrt96.ddns.net,IP:192.168.2.200"
+python tools/create_https_credentials.py
+```
+
+The key, certificate, and generated `include/tls_credentials.h` are Git-ignored. Never post or commit the private key/header. Retain the certificate (public) for a future Android app-specific trust-anchor; plan rotation/renewal. The example domain/IP must be changed if they change.
+
+## Build before any upload
+
+```powershell
+git status --short
+pio run -e esp32-s3-n16r8 *> .pio/build.log
+Get-Content .pio/build.log -Tail 25
+```
+
+The build should finish `SUCCESS`. If compilation or linking fails (including missing `esp_https_server`), stop and report concise error lines. Do **not** change frameworks/dependencies ad hoc. Do not upload a failed build. Run the existing OTA host and page tests before upload. No unattended reflash.
+
+## Hardware test (after successful build and user-initiated upload)
+
+1. Check HTTP LAN `http://192.168.2.200/` still returns JSON.
+2. Check OTA LAN `http://192.168.2.200:8081/update` still loads.
+3. Check `https://192.168.2.200/api/v1/health` via `curl.exe -k -i` **only for the read-only TLS handshake probe**. The `-k` option ignores cert validation and MUST NOT be used in KhaiRC Android or production requests. Normal Chrome may warn about the self-signed certificate.
+4. Inspect `[HTTPS]` log and free heap before/after repeated TLS handshakes and across Wi-Fi reconnect. Check no crash/reset and no degradation to MiLife read-only/IR workflows.
+5. Confirm `https://192.168.2.200/update` and `https://192.168.2.200/api/v1/ota` do not expose OTA, and HTTPS currently has no commands endpoint.
+6. Keep router WAN forwards `18080` and `999` disabled. Do not create a 443 forward in this stage.
+
+Later stage: implement HTTPS command/state APIs with correct authentication and bounds (not simple `WebServer` socket substitution), Android hostname/port/SSL validation with certificate trust anchor or verified pins, only then open the HTTPS WAN port. Keep MiLife ON/OFF separate and safety-gated.
